{
  "name": "maatify/cloudflare-turnstile",
  "description": "Unofficial PHP library for validating Cloudflare Turnstile CAPTCHA responses.",
  "keywords": [
    "turnstile",
    "cloudflare",
    "captcha",
    "php",
    "maatify"
  ],
  "homepage": "https://github.com/Maatify/CloudflareTurnstile",
  "type": "library",
  "license": "proprietary",
  "authors": [
    {
      "name": "Maatify",
      "email": "support@maatify.dev",
      "homepage": "https://maatify.dev"
    }
  ],
  "support": {
    "issues": "https://github.com/Maatify/CloudflareTurnstile/issues",
    "source": "https://github.com/Maatify/CloudflareTurnstile"
  },
  "autoload": {
    "psr-4": {
      "Maatify\\Turnstile\\": "turnstile/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Maatify\\Turnstile\\Tests\\": "tests/"
    }
  },
  "require": {
    "ext-curl": "*",
    "maatify/functions": "^5",
    "maatify/json": "^5.0.4",
    "maatify/logger": "^5.1 || ^7.0",
    "php": ">=8.4.27 <8.5.0 || >=8.5.12 <8.6.0",
    "psr/log": "^3"
  },
  "require-dev": {
    "composer/semver": "^3.4",
    "phpstan/phpstan": "^2",
    "phpunit/phpunit": "^11 || ^12"
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress --memory-limit=512M",
    "test": "phpunit",
    "test:regression": "phpunit --testsuite regression",
    "test:system": "phpunit --testsuite system"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.4.27"
    },
    "policy": {
      "advisories": {
        "block": true,
        "audit": "fail"
      },
      "malware": {
        "block": true,
        "block-scope": "all",
        "audit": "fail"
      },
      "abandoned": {
        "audit": "fail"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
