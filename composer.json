{
  "name": "maatify/cloudflare-turnstile",
  "description": "Unofficial PHP library for validating Cloudflare Turnstile CAPTCHA responses.",
  "keywords": [
    "turnstile",
    "cloudflare",
    "captcha",
    "php",
    "maatify"
  ],
  "homepage": "https://github.com/Maatify/CloudflareTurnstile",
  "type": "library",
  "license": "proprietary",
  "authors": [
    {
      "name": "Maatify",
      "email": "support@maatify.dev",
      "homepage": "https://maatify.dev"
    },
    {
      "name": "Mohamed Abdulalim",
      "email": "mohamed@maatify.dev",
      "homepage": "https://maatify.dev",
      "role": "Backend Developer"
    },
    {
      "name": "Ahmed Fawzy",
      "email": "a.fawzy@maatify.dev",
      "homepage": "https://maatify.dev",
      "role": "Frontend Developer"
    },
    {
      "name": "Mohaned Saeed Sami",
      "email": "mohaned.saeed@maatify.dev",
      "homepage": "https://maatify.dev",
      "role": "Frontend Developer"
    },
    {
      "name": "Ahmed Abdullah",
      "email": "a.abdullah@maatify.dev",
      "homepage": "https://maatify.dev",
      "role": "Android Developer"
    },
    {
      "name": "Elmokhtar Ahmed",
      "email": "mokhtar@maatify.dev",
      "homepage": "https://maatify.dev",
      "role": "IOS Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/Maatify/CloudflareTurnstile/issues",
    "source": "https://github.com/Maatify/CloudflareTurnstile"
  },
  "autoload": {
    "psr-4": {
      "Maatify\\Turnstile\\": "turnstile/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Maatify\\Turnstile\\Tests\\": "tests/"
    }
  },
  "require": {
    "ext-curl": "*",
    "maatify/functions": "^5",
    "maatify/json": "^5.0.4",
    "maatify/logger": "^5.1 || ^7.0",
    "php": ">=8.4.27 <8.5.0 || >=8.5.12 <8.6.0",
    "psr/log": "^3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11 || ^12"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.4.27"
    },
    "policy": {
      "advisories": {
        "block": true,
        "audit": "fail"
      },
      "malware": {
        "block": true,
        "block-scope": "all",
        "audit": "fail"
      },
      "abandoned": {
        "audit": "fail"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
